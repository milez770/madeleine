{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$(git rev-parse --show-toplevel)/99_Config/claude_memory/MEMORY.md\"",
            "additionalContextLimit": 20000
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/99_Scripts/session_to_thread.py\" --source codex --from-hook --quiet"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Current time: $(date '+%Y-%m-%d %H:%M %Z')\""
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/99_Scripts/recall_ppr.py\" hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/99_Scripts/session_to_thread.py\" --source codex --from-hook --quiet",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/99_Scripts/session_to_thread.py\" --source codex --from-hook --quiet",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
